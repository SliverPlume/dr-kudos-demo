# Copy to `.env` (git-ignored) and fill in your key.
# Supports both OpenAI / Codex keys (sk-...) and Google Gemini keys (AIza... or AQ....).
# Without an API key the server keeps the offline scripted replies and dictionary translation.

CODEX_API_KEY=
# AI_PROVIDER=gemini             # force Gemini (or "openai") if auto-detection guesses wrong

# Optional overrides (auto-detected from the key prefix if left commented out):
# - For OpenAI / Codex: defaults to https://api.openai.com/v1 and gpt-4o-mini
# - For Google Gemini (AIza...): defaults to https://generativelanguage.googleapis.com/v1beta/openai and gemini-3-flash-preview
# CODEX_BASE_URL=https://api.openai.com/v1
# CODEX_MODEL=gpt-4o-mini
# CODEX_API_STYLE=chat           # chat = POST /chat/completions, responses = POST /responses

# Optional tuning
# AI_PROVIDER=fake               # force scripted replies even with a key
# AI_MIN_DELAY_MS=3000           # batch window before calling the model
# AI_MAX_DELAY_MS=10000          # model deadline; falls back to scripted reply after this
# AI_HISTORY_LIMIT=20            # recent messages sent as context
# AI_REASONING_EFFORT=low        # default "low" for Gemini; unset for OpenAI
# AI_TRANSLATE_TIMEOUT_MS=8000
# AI_TRANSLATE_CONCURRENCY=4
